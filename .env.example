# ==============================================================================
# ReachInbox Outbound Email Scheduler - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER (Required)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
JWT_SECRET=reachinbox_super_secret_jwt_key_2026
SESSION_SECRET=reachinbox_super_secret_session_key_2026

# ------------------------------------------------------------------------------
# 2. DATABASE - MySQL 8+ & Prisma (Required)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://root:root@localhost:3306/reachinbox"
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=reachinbox

# ------------------------------------------------------------------------------
# 3. QUEUE & CACHE - Redis 7 & BullMQ (Required)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. FULL-TEXT SEARCH - Elasticsearch 8+ (Required)
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------------------------------
# 5. WORKER & RATE LIMITING CONTROLS (Required / Configurable)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# ------------------------------------------------------------------------------
# 6. SMTP PROVIDER (Default: 'ethereal' for sandbox testing, 'real' for production)
# ------------------------------------------------------------------------------
SMTP_PROVIDER=ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ReachInbox Scheduler <outreach@reachinbox.test>"

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 (Required for live Google login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 8. SLACK OAUTH 2.0 & API (Required for live Slack rate-limit alerts)
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
