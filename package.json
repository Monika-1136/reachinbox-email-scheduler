{
  "name": "reachinbox-email-scheduler",
  "version": "1.0.0",
  "description": "Production-grade Full-stack Email Job Scheduler with BullMQ, Redis, MySQL, Ethereal SMTP, Elasticsearch, Google & Slack OAuth",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run worker --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "reachinbox",
    "email-scheduler",
    "bullmq",
    "redis",
    "mysql",
    "prisma",
    "elasticsearch",
    "slack-oauth",
    "google-oauth"
  ],
  "author": "ReachInbox Candidate",
  "license": "MIT"
}
